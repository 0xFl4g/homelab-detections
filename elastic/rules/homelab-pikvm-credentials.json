{
  "enabled": true,
  "actions": [],
  "version": 2,
  "author": [
    "homelab"
  ],
  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "rule_id": "homelab-pikvm-credentials",
  "name": "PiKVM credential / override file changed",
  "description": "Replaces Wazuh FIM (550) on /etc/kvmd: htpasswd, totp.secret, ipmipasswd, vncpasswd, override.yaml, override.d.",
  "type": "query",
  "index": [
    "logs-host.snapshot-*"
  ],
  "language": "kuery",
  "query": "event.action:(modified or added) and labels.snapshot_item:/etc/kvmd/*",
  "severity": "high",
  "risk_score": 73,
  "tags": [
    "homelab",
    "notify",
    "wazuh:550",
    "kvmd",
    "persistence"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0003",
        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      },
      "technique": [
        {
          "id": "T1098",
          "name": "Account Manipulation",
          "reference": "https://attack.mitre.org/techniques/T1098/"
        }
      ]
    }
  ]
}
