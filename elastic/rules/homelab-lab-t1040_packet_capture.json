  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "name": "SIGMA - Packet capture tool execution (Linux)",
  "throttle": "no_actions",
  "description": "Execution of a network packet-capture tool (T1040). Missed by the prebuilt Linux rules in the detection lab (2026-10-17 coverage run).",
  "rule_id": "homelab-lab-t1040_packet_capture",
  "false_positives": [
    "Network troubleshooting by administrators"
  ],
  "immutable": false,
  "output_index": "",
  "max_signals": 100,
  "risk_score": 47,
  "risk_score_mapping": [],
  "severity": "medium",
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1040",
          "name": "Network Sniffing",
          "reference": "https://attack.mitre.org/techniques/T1040/"
        }
      ]
    }
  ],
  "tags": [
    "homelab",
    "lab"
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/techniques/T1040/"
  ],
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "eql",
  "language": "eql",
  "index": [
    "logs-*-lab"
  ],
  "query": "process where event.type == \"start\" and (process.executable like~ (\"*/tcpdump\", \"*/tshark\", \"*/dumpcap\", \"*/tethereal\", \"*/netsniff-ng\", \"*/ngrep\"))",
  "filters": []
