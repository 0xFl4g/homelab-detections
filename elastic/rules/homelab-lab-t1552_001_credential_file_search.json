{
  "enabled": true,
  "actions": [],
  "version": 1,
  "author": [
    "homelab"
  ],
  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "name": "SIGMA - Credential file search via find (Linux)",
  "throttle": "no_actions",
  "description": "find invoked to locate credential-bearing config files (T1552.001). Missed by prebuilt Linux rules in the lab coverage run.",
  "rule_id": "homelab-lab-t1552_001_credential_file_search",
  "false_positives": [
    "Developer or CI tooling searching project trees"
  ],
  "immutable": false,
  "output_index": "",
  "max_signals": 100,
  "risk_score": 47,
  "risk_score_mapping": [],
  "severity": "medium",
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1552",
          "name": "Unsecured Credentials",
          "reference": "https://attack.mitre.org/techniques/T1552/",
          "subtechnique": [
            {
              "id": "T1552.001",
              "name": "Credentials In Files",
              "reference": "https://attack.mitre.org/techniques/T1552/001/"
            }
          ]
        }
      ]
    }
  ],
  "tags": [
    "homelab",
    "lab"
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/techniques/T1552/001/"
  ],
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "eql",
  "language": "eql",
  "index": [
    "logs-*-lab"
  ],
  "query": "process where event.type == \"start\" and (process.executable:\"*/find\" and (process.command_line like~ (\"*.git-credentials*\", \"*.npmrc*\", \"*.vault-token*\", \"*.travis.yml*\", \"*.gitlab-ci.yml*\", \"*.aws/credentials*\", \"*id_rsa*\", \"*.env*\")))",
  "filters": []
}
