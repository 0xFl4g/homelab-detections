{
  "enabled": true,
  "actions": [],
  "version": 1,
  "author": [
    "homelab"
  ],
  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "rule_id": "homelab-100004",
  "name": "Privileged or host-PID container appeared",
  "description": "Port of Wazuh 100004 via osquery docker_containers (Docker events never carry HostConfig, so the Wazuh rule could not fire).",
  "type": "query",
  "index": [
    "logs-osquery.result-*"
  ],
  "language": "kuery",
  "query": "osquery.name:docker_privileged and osquery.action:added and osquery.counter > 0",
  "severity": "critical",
  "risk_score": 99,
  "tags": [
    "homelab",
    "notify",
    "wazuh:100004",
    "privilege_escalation"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0004",
        "name": "Privilege Escalation",
        "reference": "https://attack.mitre.org/tactics/TA0004/"
      },
      "technique": [
        {
          "id": "T1611",
          "name": "Escape to Host",
          "reference": "https://attack.mitre.org/techniques/T1611/"
        }
      ]
    },
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1610",
          "name": "Deploy Container",
          "reference": "https://attack.mitre.org/techniques/T1610/"
        }
      ]
    }
  ]
