{
  "enabled": true,
  "actions": [],
  "version": 1,
  "author": [
    "homelab"
  ],
  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "name": "SIGMA - Shell history credential access (Linux)",
  "throttle": "no_actions",
  "description": "Reading a shell history file, often to harvest credentials typed on the command line (T1552.003). Missed by prebuilt Linux rules in the lab coverage run.",
  "rule_id": "homelab-lab-t1552_003_shell_history_access",
  "false_positives": [
    "A user legitimately inspecting their own shell history"
  ],
  "immutable": false,
  "output_index": "",
  "max_signals": 100,
  "risk_score": 21,
  "risk_score_mapping": [],
  "severity": "low",
  "severity_mapping": [],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1552",
          "name": "Unsecured Credentials",
          "reference": "https://attack.mitre.org/techniques/T1552/",
          "subtechnique": [
            {
              "id": "T1552.003",
              "name": "Shell History",
              "reference": "https://attack.mitre.org/techniques/T1552/003/"
            }
          ]
        }
      ]
    }
  ],
  "tags": [
    "homelab",
    "lab"
  ],
  "to": "now",
  "references": [
    "https://attack.mitre.org/techniques/T1552/003/"
  ],
  "exceptions_list": [],
  "related_integrations": [],
  "required_fields": [],
  "setup": "",
  "type": "eql",
  "language": "eql",
  "index": [
    "logs-*-lab"
  ],
  "query": "process where event.type == \"start\" and ((process.command_line like~ (\"*.bash_history*\", \"*.zsh_history*\", \"*.mysql_history*\", \"*.sh_history*\", \"*.psql_history*\", \"*.rediscli_history*\")) and (not process.executable:\"*/history\"))",
  "filters": []
}
