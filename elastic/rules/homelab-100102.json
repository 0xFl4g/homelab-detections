  "rule_id": "homelab-100102",
  "name": "SSH login from an external IP",
  "description": "Port of Wazuh 100102 on all three hosts; RFC1918, loopback and 100.64.0.0/10 (Tailscale — 100% of Wazuh's 391 hits in 30 d) excluded. IPv6 ULA (incl. Tailscale fd7a:115c:a1e0::/48), link-local and loopback excluded (2c-2 review).",
  "type": "query",
  "index": [
    "logs-system.auth-*"
  ],
  "language": "kuery",
  "query": "event.action:ssh_login and event.outcome:success and not source.ip:(10.0.0.0/8 or 172.16.0.0/12 or 192.168.0.0/16 or 127.0.0.0/8 or 100.64.0.0/10 or \"fc00::/7\" or \"fe80::/10\" or \"::1/128\")",
  "severity": "high",
