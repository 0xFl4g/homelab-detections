{
  "enabled": true,
  "actions": [],
  "version": 2,
  "author": [
    "homelab"
  ],
  "license": "internal",
  "interval": "5m",
  "from": "now-6m",
  "rule_id": "homelab-100023",
  "name": "SSH access configuration changed",
  "description": "Port of Wazuh 100023: authorized_keys / sshd_config(.d) hash change (host-snapshot) or osquery authorized_keys diff (Unraid).",
  "type": "query",
  "index": [
    "logs-host.snapshot-*",
    "logs-osquery.result-*"
  ],
  "language": "kuery",
  "query": "(event.action:(modified or added) and labels.snapshot_item:(\"/root/.ssh/authorized_keys\" or \"/etc/ssh/sshd_config\" or \"/usr/local/etc/ssh/sshd_config\" or /etc/ssh/sshd_config.d/*)) or (osquery.name:authorized_keys and osquery.counter > 0)",
  "severity": "high",
  "risk_score": 73,
  "tags": [
    "homelab",
    "notify",
    "wazuh:100023",
    "persistence"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0003",
        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      },
      "technique": [
        {
          "id": "T1098",
          "name": "Account Manipulation",
          "reference": "https://attack.mitre.org/techniques/T1098/",
          "subtechnique": [
            {
              "id": "T1098.004",
              "name": "SSH Authorized Keys",
              "reference": "https://attack.mitre.org/techniques/T1098/004/"
            }
          ]
        }
      ]
    }
  ]
}
